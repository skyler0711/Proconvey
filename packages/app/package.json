{
  "name": "@proconvey/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"NEXT,CODEGEN\" -c bgCyan,bgMagenta \"next dev\" \"yarn codegen --watch\"",
