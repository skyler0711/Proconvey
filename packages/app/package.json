    "@stripe/stripe-js": "^1.46.0",
    "@types/js-cookie": "^3.0.2",
    "@types/laravel-vapor": "^0.6.1",
    "@types/node": "^18.11.18",
    "@types/react": "18.0.26",
    "@types/react-dom": "18.0.10",
    "axios": "^1.4.0",
    "dayjs": "^1.11.7",
    "eslint": "8.31.0",
    "eslint-config-next": "13.1.1",
    "graphql": "^16.6.0",
    "js-cookie": "^3.0.1",
    "laravel-vapor": "^0.6.0",
    "next": "13.1.1",
    "next-seo": "^5.15.0",
    "next-urql": "^4.0.2",
